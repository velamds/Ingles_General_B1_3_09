nt": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "engenn8le09ob11re3aud03"}]}], "id": 4, "_data": [{"type": "question", "contents": [{"type": "text", "content": "Employing children is a crime in Canada. "}]}, {"type": "objective", "content": "secondary_1"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 5, "_data": [{"type": "question", "contents": [{"type": "rec", "content": ""}]}, {"type": "objective", "content": "secondary_1"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "engenn8le09ob11re3aud04"}]}], "id": 6, "_data": [{"type": "question", "contents": [{"type": "text", "content": "Holly's should be punished, not trusted to change. "}]}, {"type": "objective", "content": "secondary_1"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 7, "_data": [{"type": "question", "contents": [{"type": "rec", "content": ""}]}, {"type": "objective", "content": "secondary_1"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "engenn8le09ob11re3aud05"}]}], "id": 8, "_data": [{"type": "question", "contents": [{"type": "text", "content": "Join forces with others concerned about the offshore crime of Canadian businesses. "}]}, {"type": "objective", "content": "secondary_1"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 9, "_data": [{"type": "question", "contents": [{"type": "rec", "content": ""}]}, {"type": "objective", "content": "secondary_1"}]}], "type": "SR1", "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Who can you trust?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 1"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "You are done!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">\nListen to the audio. </span> <span class=\"bullet\">\nRecord yourself saying the sentences aloud.</span>\n <span class=\"bullet\">Compare yourself to the audio.</span>"}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le09ob11re2img01.jpg", "audiosrc": "engenn8le09ob11re2aud01", "images": [{"time": "0", "image": "engenn8le09ob11re2img01.jpg", "id": 0, "text": ""}, {"time": "00100", "image": "engenn8le09ob11re2img01.jpg", "id": 1, "text": "Three cheers for Boston Broadcasters! Yesterday, they really shut down Polygon's effort to whitewash over the Holly's Wear scandal. Here's an overview of the report.\n<br />First, Miranda Morehouse says they are deeply distressed by the situation. Why was Morehouse so distressed? She says they were deceived and made complicit in human rights abuses. She doesn't say she was distressed at what was happening to workers in Tindasia. Just at being deceived and finding her company  involved. If she's that selfish, why listen further?"}, {"time": "39000", "image": "engenn8le09ob11re2img02.jpg", "id": 2, "text": "Next, Morehouse emphasized Polygon's strong ethical stand against child labor. But as she was asked last night, \u201cHow can you still support Holly's if you have a strong ethical stand? Employing children is a crime in the United States of America. Holly's should be punished, not trusted to change. That was Morehouse's third point. She said Holly's would change. But if they employed children until found out, what are their ethics like elsewhere? If they are willing to commit crime where it won't be punished, then how can they be trusted?"}, {"time": "76000", "image": "engenn8le09ob11re2img03.jpg", "id": 3, "text": "Fourth, Morehouse said they took action only after learning about a social media leak. They were worried about public image! She said they didn't know it was happening. Really? Holly's didn't want to know.  ... It's time for action! Join forces with others concerned about the offshore crime of American businesses and the protection of human rights. We will hold a workshop on how to petition and boycott in the Williams Building at 1:30pm this Saturday. Learn how we can join forces to shut this company down!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Controlling the Story"}, {"type": "unit_name", "content": "A Blogger's Point of View"}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 9}, {"type": "level", "content": "B1.3"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Exchange information using a wider range of language."}, {"type": "secondary_1", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_2", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_3", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_4", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_5", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_6", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_7", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_8", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}], "type": "objectives"}, {"type": "background_image", "content": "engenn8le09ob11re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of a situation you feel strongly about."}, {"type": "text", "content": "Organize an argument with several points about what you think of the situation."}, {"type": "text", "content": "Order your points with clear, but varied language."}, {"type": "text", "content": "Ask probing questions about each point"}, {"type": "text", "content": "Use words that will have an effect on people's emotions."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I organize an argument about a situation I feel strongly about."}, {"type": "text", "content": "I order an argument with clear but varied language."}, {"type": "text", "content": "I ask probing questions."}, {"type": "text", "content": "I use vocabulary that can affect people emotionally."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Using the Conditional \u2018if-then' Construction in Questions"}, {"type": "describer", "content": "Probing questions try to get at deep understandings of an issue. The conditional construction can be useful for this. When one fact depends on another fact to be true, then we use the \u2018if-then' construction."}, {"type": "text", "content": "We may be told something that we are not sure that we believe because of something else we have heard or experienced. We may express each idea in a clause, making one dependent on the other. You know one thing is true, so the other one is false unless someone has some information that is not obvious."}, {"type": "text", "content": "Example: Something you heard doesn't seem to make sense because of something you observed. Is what you heard wrong, or is there more information that is missing?"}, {"type": "text", "content": "<span class=\"italic\"><ol>1. You have heard that your colleague is quitting his job. <br />2. You observe your colleague put more money on his cafeteria lunch card, as if he were staying longer.</ol>"}, {"type": "text", "content": "Probing Question: If he is quitting his job, then why did he put more money on his cafeteria lunch card?"}, {"type": "text", "content": "There are two sides to your question. One is asked, but the second, unasked question, is <span class=\"underline\">what you really want to know</span> most. <ol>1. Asked: <span class=\"italic\">Why did he put money on his card</span>? <br />2. Unasked: <span class=\"italic\">Is he really quitting? Maybe he isn't!</span></ol>"}, {"type": "text", "content": "Mostly likely it is NOT true that your colleague is quitting. But there may be information you don't know about. For instance, perhaps he is going to gift his meal card to another colleague when he leaves."}, {"type": "text", "content": "Remember that sometimes \u2018then' is not stated because it is understood."}, {"type": "example", "content": "<span class=\"underline\">If</span> he is a true friend (may or may not be true), <span class=\"underline\">then why</span> did he tell the boss about my problems? (only partially true information)<br /><br /><span class=\"underline\">(Missing piece of information</span>: the boss already knew about my problems and asked him to clarify)<br /><br />"}, {"type": "example", "content": "<span class=\"underline\">If</span> you won't stand up for older people on the bus (may or may not be true), <span class=\"underline\">then why</span> should I believe that you are caring? (assumption without all the facts)<br /><br />(<span class=\"underline\">Missing piece of information</span>: you have a heart condition and cannot stand for long)<br /><br />"}, {"type": "example", "content": "<span class=\"underline\">If</span> reindeer can't fly (may or may not be true), <span class=\"underline\">how can</span> Santa get to all the rooftops with his sleigh every Christmas? (missing some information)<br /><br />(<span class=\"underline\">Missing piece of information</span>: Santa and his reindeer are magic!)"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Planning an Argument"}, {"type": "describer", "content": "When preparing to deal with a sensitive matter, it is important for both the speaker and listener to stay focussed. A carefully planned argument is clearest when points are ordered with brief statements."}, {"type": "text", "content": "The listener must be able to focus on where each point is in the argument and this is done best with short sentences. A clear structure makes the argument look more rational."}, {"type": "text", "content": "Labelling or numbering your points in an argument shows the reader that there are quite a few reasons to believe you, even if you do not have much time to develop your ideas or provide examples. "}, {"type": "example", "content": "The first argument against racism is that it is ..."}, {"type": "example", "content": "The second argument against this practise is ..."}, {"type": "example", "content": "Next, racism is clearly ..."}, {"type": "example", "content": "Finally, racism must be fought because ..."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "overview"}, {"type": "definition", "content": "a short summary of the main points"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  Miranda, would you give us an overview of this situation?"}, {"type": "audio", "content": "engenn8le09ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are the words to review."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "ethical stand"}, {"type": "definition", "content": "to make a strong public decision about what is right or wrong and act according to that decision"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example:  Now this is common and legal in Tindasia, but we have a strong ethical stand against child labour"}, {"type": "audio", "content": "engenn8le09ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to deceive"}, {"type": "definition", "content": "to cause someone to think differently than the truth"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  We are in a distressing situation since we recently discovered that we were deceived and made complicit in human rights abuses."}, {"type": "audio", "content": "engenn8le09ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "complicit"}, {"type": "definition", "content": "involved with others in doing wrong"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: We must bring positive changes to society rather than finding ourselves complicit in exploitation."}, {"type": "audio", "content": "engenn8le09ob11aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "boycott"}, {"type": "definition", "content": "a group decision to stop buying products or having any relations with a company"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: If we don't deal with this immediately, there could be boycotts of your product."}, {"type": "audio", "content": "engenn8le09ob11aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "petition"}, {"type": "definition", "content": "a formal request to make change, with signatures from many people"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Petitions have begun."}, {"type": "audio", "content": "engenn8le09ob11aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "joining forces"}, {"type": "definition", "content": "putting together the energies of various people or groups"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Giorgio Farmani (CEO) and Janet Ellis (president of Polygon) are joining forces."}, {"type": "audio", "content": "engenn8le09ob11aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "crime"}, {"type": "definition", "content": "an action that is punishable by law"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Although no crime was found, the company was very upset."}, {"type": "audio", "content": "engenn8le09ob11aud08"}]}]}