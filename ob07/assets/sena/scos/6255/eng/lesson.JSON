! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Read the sentences and select all the possible answers.\n", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}], "type": "MMM", "template_override": 1}, {"id": 7, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "Many buyers are coming in on Tuesday.", "type": "text"}]}, {"content": "secondary_6", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "correct": 0, "_data": [{"content": "true", "type": "text"}]}, {"id": 1, "selected": 0, "correct": 1, "_data": [{"content": "false", "type": "text"}]}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "A few of their remaining staff are on vacation.", "type": "text"}]}, {"content": "secondary_6", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "correct": 0, "_data": [{"content": "true", "type": "text"}]}, {"id": 1, "selected": 0, "correct": 1, "_data": [{"content": "false", "type": "text"}]}], "id": 1}, {"_data": [{"type": "question", "contents": [{"content": "Little of the company remains after the sale.", "type": "text"}]}, {"content": "secondary_6", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "correct": 1, "_data": [{"content": "true", "type": "text"}]}, {"id": 1, "selected": 0, "correct": 0, "_data": [{"content": "false", "type": "text"}]}], "id": 2}], "_data": [{"type": "instructions", "contents": [{"content": " \nBryan discusses this week's plan.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.",